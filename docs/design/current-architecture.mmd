  Container(web, "Web app", "React 19, Vite, PWA", "web/src and 15 plugins in web/plugins. Built to web/dist")
  Container(mods, "Window mods (28) [not in pilot]", "JavaScript in herdr-app", "mods/*/main.js")
  Container(shared, "Shared logic", "JavaScript library, not a process", "core/ and lib/; copied into mods by bin/sync-shared")
  Container(svc, "Service", "Bun 1.4.4, one per machine", "service/main.ts. proc: bun service/main.ts on 127.0.0.1:7788")
  Container(task, "herdr-task", "Python 3 task engine", "mods/tasks/bin/herdr-task. proc: herdr-task scheduler, herdr-task _track")
  Container(helpers, "Helper CLIs", "Python and shell", "herdr-artifact, herdr-secret, herdr-browser in ~/.local/bin")
  Container(installer, "Installer and doctor", "Python 3, on demand", "bin/shepherdr")
  ContainerDb(files, "Saved task files", "JSON and locks", "~/.local/share/shepherdr/tasks/*.json")
  ContainerDb(journal, "Launch journal [fork]", "JSON, fsync and rename", "tasks/.launches.json")
  ContainerDb(claims, "Publication claims [fork]", "JSON", "tasks/.publications.json. Not yet created in pilot")
  ContainerDb(settings, "Settings file", "JSON", "~/.config/shepherdr/settings.json")
  ContainerDb(local, "Local state", "JSON", "~/.local/state/shepherdr: service/service.json, web.json; codex-sandbox.json [new]")
}
